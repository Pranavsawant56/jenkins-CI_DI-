pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Getting latest Express frontend code from GitHub'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('express-frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                sh 'sudo -n /usr/local/bin/jenkins-deploy-app express'
            }
        }
    }
}