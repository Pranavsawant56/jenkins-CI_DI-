
pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Getting latest frontend code from GitHub'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('express-frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Deploy Frontend') {
            steps {
                dir('express-frontend') {
                    sh '''
                        if pm2 describe express-frontend >/dev/null 2>&1; then
                            pm2 restart express-frontend
                        else
                            pm2 start server.js --name express-frontend
                        fi
                    '''
                }
            }
        }
    }
}
