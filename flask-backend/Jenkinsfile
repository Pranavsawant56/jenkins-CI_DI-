pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Getting latest Flask backend code from GitHub'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('flask-backend') {
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Deploy Backend') {
            steps {
                sh 'sudo -n /usr/local/bin/jenkins-deploy-app flask'
            }
        }
    }
}